rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
//
// Everything here is gated on one thing: a signed-in Google account whose
// verified email is on the nprep.in domain. The web config in the repository
// is public; this file is what actually protects the data.

service cloud.firestore {
  match /databases/{database}/documents {

    function nprep() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@nprep[.]in');
    }

    function taskDeletionOwner() {
      return nprep()
        && request.auth.uid == 'XPLO57VwLWZnXGaI2uJzVL4qx6t2'
        && request.auth.token.email.lower() == 'ashutosh_mishra@nprep.in';
    }

    // The plan itself: anyone on the team reads and writes it.
    match /campaigns/{campaignId} {
      allow read, create, update: if nprep();
      // Campaign deletion also removes its tasks, so it has the same owner gate.
      allow delete: if taskDeletionOwner();
    }
    match /activities/{activityId} {
      allow read, create, update: if nprep();
      allow delete: if taskDeletionOwner();
    }
    // The internal student portal shares the existing verified NPrep team access.
    // A profile and its canonical campaign task must be written together.
    match /testimonials/{studentId} {
      function validStudent() {
        let s = request.resource.data;
        let a = getAfter(/databases/$(database)/documents/activities/$(s.activityId)).data;
        return s.keys().hasOnly(['studentName','examName','rank','city','state','college','interviewStatus','interviewDate','interviewTime','facultyName','facultyEmail','facultyTeams','scheduleUrl','scheduleRevision','recordingUrl','notes','campaignId','coordinator','contentDueDate','activityId','revision','createdBy','createdAt','updatedBy','updatedAt'])
          && s.studentName is string && s.studentName.size() > 0 && s.studentName.size() <= 140
          && s.examName is string && s.examName.size() > 0 && s.examName.size() <= 200
          && s.rank is string && s.rank.size() <= 60
          && s.city is string && s.city.size() <= 120
          && s.state is string && s.state.size() <= 120
          && s.college is string && s.college.size() <= 240
          && s.interviewStatus in ['not_scheduled','scheduled','recorded']
          && s.interviewDate is string && (s.interviewDate == '' || s.interviewDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && s.interviewTime is string && (s.interviewTime == '' || s.interviewTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
          && s.facultyName is string && s.facultyName.size() <= 140
          && s.facultyEmail is string && s.facultyEmail.size() <= 200 && (s.facultyEmail == '' || s.facultyEmail.matches('^[^ @]+@[^ @]+[.][^ @]+$'))
          && s.facultyTeams is string && s.facultyTeams.size() <= 200 && (s.facultyTeams == '' || s.facultyTeams.matches('^[^ @]+@[^ @]+[.][^ @]+$'))
          && s.scheduleUrl is string && s.scheduleUrl.size() <= 2000 && (s.scheduleUrl == '' || s.scheduleUrl.matches('^https?://[^ /]+.*'))
          && s.scheduleRevision is int && s.scheduleRevision >= 0
          && (s.interviewStatus != 'scheduled' || (s.interviewDate != '' && s.interviewTime != '' && s.facultyName != '' && s.facultyEmail != '' && s.facultyTeams != '' && s.scheduleUrl != ''))
          && s.recordingUrl is string && s.recordingUrl.size() <= 2000 && (s.recordingUrl == '' || s.recordingUrl.matches('^https?://[^ /]+.*'))
          && (s.interviewStatus != 'recorded' || s.recordingUrl != '')
          && s.notes is string && s.notes.size() <= 2000
          && s.campaignId is string && s.campaignId.size() > 0 && s.campaignId.size() <= 160
          && s.coordinator is string && s.coordinator.size() <= 200
          && s.contentDueDate is string && s.contentDueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && s.activityId == 'testimonial-' + studentId && a.testimonialId == studentId
          && a.campaignId == s.campaignId && a.dueDate == s.contentDueDate && a.owner == s.coordinator
          && a.testimonial.studentName == s.studentName && a.testimonial.examName == s.examName
          && a.testimonial.interviewStatus == s.interviewStatus && a.testimonial.recordingUrl == s.recordingUrl
          && s.revision is int && s.revision > 0
          && s.createdBy is string && s.createdAt is string && s.updatedAt is string && s.updatedBy == request.auth.uid;
      }
      allow read: if nprep();
      allow create: if nprep() && validStudent() && request.resource.data.revision == 1 && request.resource.data.createdBy == request.auth.uid;
      allow update: if nprep() && validStudent()
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.activityId == resource.data.activityId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /subtaskTemplates/{templateId} {
      allow read, update, delete: if nprep();
    }
    match /sopRules/{ruleId} {
      function reservedName() {
        return request.resource.data.nameKey is string
          && getAfter(/databases/$(database)/documents/sopNameClaims/$(request.resource.data.nameKey)).data.sopId == ruleId
          && getAfter(/databases/$(database)/documents/sopNameClaims/$(request.resource.data.nameKey)).data.name == request.resource.data.name;
      }
      allow read, delete: if nprep();
      allow create: if nprep() && reservedName();
      allow update: if nprep() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled', 'archived'])
        || reservedName()
      );
    }
    match /sopNameClaims/{nameKey} {
      allow read, write: if nprep();
    }

    // Delivery receipts are shared with the same internal team as the profiles.
    match /testimonialInvitations/{invitationId} {
      allow read: if nprep();
      allow create, update: if nprep()
        && request.resource.data.keys().hasOnly(['studentId','scheduleRevision','scheduleKey','email','teams'])
        && request.resource.data.studentId is string
        && request.resource.data.scheduleRevision is int && request.resource.data.scheduleRevision > 0
        && request.resource.data.scheduleKey is string && request.resource.data.scheduleKey.size() == 64
        && request.resource.data.email is map && request.resource.data.teams is map;
    }

    // Assignable people exist independently of authenticated accounts.
    match /teamMembers/{memberId} {
      function validMember() {
        let m = request.resource.data;
        return m.keys().hasOnly(['name', 'email', 'role', 'nameKey', 'emailKey', 'createdBy', 'createdAt', 'updatedAt', 'revision'])
          && m.name is string && m.name.size() > 0 && m.name.size() <= 100
          && m.email is string && m.email.size() <= 200
          && m.role is string && m.role.size() <= 80
          && m.nameKey is string && m.emailKey is string
          && m.createdBy is string && m.createdAt is string && m.updatedAt is string && m.revision is int && m.revision > 0
          && getAfter(/databases/$(database)/documents/teamMemberNameClaims/$(m.nameKey)).data.memberId == memberId
          && getAfter(/databases/$(database)/documents/teamMemberNameClaims/$(m.nameKey)).data.name == m.name
          && (m.email == '' || (
            getAfter(/databases/$(database)/documents/teamMemberEmailClaims/$(m.emailKey)).data.memberId == memberId
            && getAfter(/databases/$(database)/documents/teamMemberEmailClaims/$(m.emailKey)).data.email == m.email
          ));
      }
      allow read: if nprep();
      allow create: if nprep() && validMember() && request.resource.data.createdBy == request.auth.uid;
      allow update: if nprep() && validMember()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /teamMemberNameClaims/{nameKey} {
      allow read, write: if nprep();
    }
    match /teamMemberEmailClaims/{emailKey} {
      allow read, write: if nprep();
    }

    // Shared dropdown choices; stable IDs preserve tasks and SOP conditions.
    match /workspaceSettings/contentOptions {
      allow read: if nprep();
      function validOptions() {
        let o = request.resource.data;
        return o.keys().hasOnly(['version', 'platforms', 'updatedAt', 'updatedBy'])
          && o.version is int && o.platforms is list && o.platforms.size() <= 30
          && o.updatedAt is string && o.updatedBy == request.auth.uid;
      }
      allow create: if nprep() && validOptions() && request.resource.data.version == 1;
      allow update: if nprep() && validOptions()
        && request.resource.data.version == resource.data.version + 1;
    }

    // Reusable weekly content mix, separate from campaigns and task completion.
    match /workspaceSettings/weeklyPlanner {
      allow read: if nprep();
      function validPlan() {
        let p = request.resource.data;
        return p.keys().hasOnly(['version', 'cells', 'updatedAt', 'updatedBy'])
          && p.version is int && p.cells is map && p.cells.size() == 56
          && p.updatedAt is string && p.updatedBy == request.auth.uid;
      }
      allow create: if nprep() && validPlan() && request.resource.data.version == 1;
      allow update: if nprep() && validPlan()
        && request.resource.data.version == resource.data.version + 1;
    }

    // The roster, so owner names resolve. You may only write your own row.
    match /users/{uid} {
      allow read: if nprep();
      allow create, update: if nprep() && request.auth.uid == uid
        && request.resource.data.email.lower() == request.auth.token.email.lower();
      allow delete: if nprep() && request.auth.uid == uid;
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
